NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Add if map components require it
NEXT_PUBLIC_MAPBOX_TOKEN=

# Direct browser → Cloudinary uploads for abode photos. STRONGLY recommended
# in production: bypasses Render's free-tier dyno and gives real per-byte
# upload progress.
#
# Setup:
#   1. Cloudinary dashboard → Settings → Upload → Upload presets → Add new.
#   2. Mode = "Unsigned". Folder (optional) = "triberoutes/abodes".
#   3. Save the preset name and your cloud name.
#   4. Set both vars below in Vercel (Production + Preview).
#   5. The backend already accepts *.cloudinary.com URLs, no server change needed.
#
# If either var is missing, the frontend silently falls back to the legacy
# backend-proxied upload (slower, no progress bar).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
